# Copy to .env. Never fill secrets into this tracked example.
# Paths are local only: Java 21, Gradle 8.13, Android SDK 35, x64 MinGW-w64.
JAVA_HOME=
ANDROID_HOME=
GRADLE_HOME=
GRADLE_USER_HOME=
ANDROID_USER_HOME=
MINGW_CXX=
# Optional local test dependencies; otherwise install npm dependencies.
AUDIOHUB_PLAYWRIGHT_MODULE=
AUDIOHUB_BROWSER_EXECUTABLE=
AUDIOHUB_BROWSER_CHANNEL=
AUDIOHUB_KEYSTORE=.signing/audiohub-release.p12
AUDIOHUB_KEY_ALIAS=audiohub-release
AUDIOHUB_STORE_PASSWORD=
AUDIOHUB_KEY_PASSWORD=
